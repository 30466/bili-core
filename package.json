{
  "name": "bili-core",
  "version": "0.1.0",
  "private": true,
  "description": "Bilibili creator video crawler, metadata exporter, and Hi-Res/DASH media downloader CLI",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bili": "./bin/bili.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:time": "npm run build && TZ=Asia/Shanghai node --test test/time.test.mjs && TZ=UTC node --test test/time.test.mjs && TZ=America/New_York node --test test/time.test.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node bin/bili.js",
    "get-cookie": "node scripts/get-cookie.mjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "js-md5": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "playwright": "^1.61.1",
    "tsx": "^4.17.0",
    "typescript": "^5.4.0"
  }
}
